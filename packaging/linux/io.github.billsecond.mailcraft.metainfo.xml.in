<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream metadata (software centres, Flathub). Template: package.sh and the Flatpak
     manifest substitute @VERSION@ and @DATE@ from Cargo.toml and the build date. -->
<component type="desktop-application">
  <id>io.github.billsecond.mailcraft</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <name>MailCraft</name>
  <summary>Read and write mail, keep a calendar, contacts and tasks</summary>
  <developer id="io.github.billsecond">
    <name>MailCraft contributors</name>
  </developer>
  <description>
    <p>
      MailCraft is a fast, open-source mail program with a familiar ribbon: mail with folders, rules, flags and categories, a calendar with recurring events, contacts and tasks. It talks to IMAP and SMTP servers, reads and writes .eml, .mbox, .ics and .vcf files, and can be driven by AI agents over MCP.
    </p>
  </description>
  <launchable type="desktop-id">io.github.billsecond.mailcraft.desktop</launchable>
  <icon type="stock">io.github.billsecond.mailcraft</icon>
  <!-- Only url types known to appstream 0.15 (Ubuntu 22.04, where CI validates): no vcs-browser. -->
  <url type="homepage">https://github.com/UCS-Care-Group/mailcraft</url>
  <url type="bugtracker">https://github.com/UCS-Care-Group/mailcraft/issues</url>
  <url type="help">https://github.com/UCS-Care-Group/mailcraft</url>
  <url type="contact">https://github.com/UCS-Care-Group/mailcraft/issues</url>
  <categories>
    <category>Office</category>
    <category>WordProcessor</category>
  </categories>
  <keywords>
    <keyword>mail</keyword>
    <keyword>calendar</keyword>
    <keyword>contacts</keyword>
    <keyword>writer</keyword>
  </keywords>
  <screenshots>
    <screenshot type="default">
      <caption>The Open Studio Handbook sample with the Navigation pane</caption>
      <image>https://raw.githubusercontent.com/billsecond/mailcraft/main/docs/images/mail-dark.png</image>
    </screenshot>
  </screenshots>
  <branding>
    <color type="primary" scheme_preference="light">#b9c7f5</color>
    <color type="primary" scheme_preference="dark">#2b47b5</color>
  </branding>
  <requires>
    <display_length compare="ge">760</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>tablet</control>
  </supports>
  <provides>
    <binary>mailcraft</binary>
  </provides>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="@VERSION@" date="@DATE@"/>
  </releases>
</component>
